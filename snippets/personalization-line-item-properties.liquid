{% comment %}
  Hidden line item properties synchronized by personalization-preview.js.

  Accepts:
  - product: {Object} Product object.
  - personalization_scope: {String} Unique scope for state isolation.
{% endcomment %}

{%- if product != blank and personalization_scope != blank -%}
  {%- capture personalization_enabled_output -%}
    {%- render 'personalization-product-enabled', product: product -%}
  {%- endcapture -%}
  {%- assign personalization_enabled = personalization_enabled_output | strip -%}
  {%- if personalization_enabled == 'true' -%}
  {%- liquid
    assign requires_custom_option = false
    assign is_custom_option_selected = false

    for variant in product.variants
      capture variant_tokens
        echo variant.title
        echo '|'
        echo variant.options | join: '|'
      endcapture
      assign variant_tokens = variant_tokens | downcase
      if variant_tokens contains 'custom engraving'
        assign requires_custom_option = true
        break
      endif
    endfor

    if requires_custom_option == false
      for option in product.options_with_values
        capture option_tokens
          echo option.name
          echo '|'
          echo option.values | join: '|'
        endcapture
        assign option_tokens = option_tokens | downcase
        if option_tokens contains 'custom engraving'
          assign requires_custom_option = true
          break
        endif
      endfor
    endif

    assign selected_variant = product.selected_or_first_available_variant
    if selected_variant != blank
      capture selected_variant_tokens
        echo selected_variant.title
        echo '|'
        echo selected_variant.options | join: '|'
      endcapture
      assign selected_variant_tokens = selected_variant_tokens | downcase
      if selected_variant_tokens contains 'custom engraving'
        assign is_custom_option_selected = true
      endif
    endif
  -%}
  <div
    class="personalization-line-item-properties"
    data-personalization-context
    data-personalization-scope="{{ personalization_scope }}"
    data-personalization-product-id="{{ product.id }}"
    data-personalization-requires-custom-option="{{ requires_custom_option }}"
    data-personalization-enabled="{% if requires_custom_option and is_custom_option_selected == false %}false{% else %}true{% endif %}"
  >
    <input
      type="hidden"
      name="properties[Personalization Primary Text]"
      value=""
      data-personalization-property="primary"
    >
    <input
      type="hidden"
      name="properties[Personalization Secondary Text]"
      value=""
      data-personalization-property="secondary"
    >
    <input
      type="hidden"
      name="properties[Personalization Style]"
      value="Handwritten 1"
      data-personalization-property="style"
    >
    <input
      type="hidden"
      name="properties[Personalization Name 1]"
      value=""
      data-personalization-property="name1"
    >
    <input
      type="hidden"
      name="properties[Personalization Name 2]"
      value=""
      data-personalization-property="name2"
    >
    <input
      type="hidden"
      name="properties[Personalization Date]"
      value=""
      data-personalization-property="date"
    >
    <input
      type="hidden"
      name="properties[Personalization Icon]"
      value=""
      data-personalization-property="icon"
    >
    <input
      type="hidden"
      name="properties[_Personalization Gemini Preview]"
      value=""
      data-personalization-property="gemini_summary"
    >
    <input
      type="hidden"
      name="properties[_Personalization Scope]"
      value="{{ personalization_scope }}"
      data-personalization-property="scope"
    >
    <input
      type="file"
      name="properties[Personalization Stage Preview]"
      accept="image/png,image/jpeg,image/webp"
      data-personalization-property="stage_preview_file"
      hidden
    >
  </div>
  {%- endif -%}
{%- endif -%}
