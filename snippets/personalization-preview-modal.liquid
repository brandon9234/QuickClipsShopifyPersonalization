<modal-dialog id="PersonalizationPreviewModal" class="personalization-preview-modal">
  <div
    role="dialog"
    aria-modal="true"
    aria-label="Personalization preview"
    class="personalization-preview-modal__content global-settings-popup"
    tabindex="-1"
  >
    <button
      id="ModalClose-PersonalizationPreviewModal"
      type="button"
      class="personalization-preview-modal__toggle"
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {% render 'icon-close' %}
    </button>

    <div class="personalization-preview-modal__body">
      <div class="personalization-preview-modal__header">
        <h2 class="h3">Customize Your Product</h2>
        <p class="personalization-preview-modal__product" data-personalization-product-name hidden></p>
      </div>

      <div class="personalization-preview-modal__workspace">
        <div class="personalization-preview-modal__preview" aria-live="polite" data-personalization-picked-panel>
          <p class="personalization-preview-modal__preview-label">Stage preview</p>
          <div
            class="personalization-preview-modal__blank-clip is-handwritten-1"
            data-personalization-clip-surface
            data-personalization-stage-image-url="{{ 'HorizontalOGQuickClipZoomed.jpg' | asset_url }}"
            data-personalization-safe-area-url="{{ 'HorizontalOGQuickClipZoomedOverLay.jpg' | asset_url }}"
          >
            <img
              class="personalization-preview-modal__style-preview-image"
              data-personalization-style-preview-image
              alt="Selected style preview"
              hidden
            >
            <div
              class="personalization-preview-modal__safe-area-boundary"
              data-personalization-safe-area-boundary
              aria-hidden="true"
            ></div>
            <div
              class="personalization-preview-modal__clip-guide-boundary"
              data-personalization-clip-guide-boundary
              aria-hidden="true"
              style="display: none !important;"
              hidden
            ></div>
            <div
              class="personalization-preview-modal__deterministic-overlay"
              data-personalization-deterministic-overlay
              hidden
            >
              <div class="personalization-preview-modal__deterministic-textbox personalization-preview-modal__deterministic-textbox--name" data-personalization-textbox="lastName">
                <p class="personalization-preview-modal__deterministic-line personalization-preview-modal__deterministic-line--name" data-personalization-deterministic-last-name></p>
                <button
                  type="button"
                  class="personalization-preview-modal__resize-handle"
                  data-personalization-resize="lastName"
                  aria-label="Resize last name text box"
                ></button>
              </div>
              <div class="personalization-preview-modal__deterministic-textbox personalization-preview-modal__deterministic-textbox--date" data-personalization-textbox="date">
                <p class="personalization-preview-modal__deterministic-line personalization-preview-modal__deterministic-line--date" data-personalization-deterministic-date></p>
                <button
                  type="button"
                  class="personalization-preview-modal__resize-handle"
                  data-personalization-resize="date"
                  aria-label="Resize date text box"
                ></button>
              </div>
              <div class="personalization-preview-modal__icon-layer" data-personalization-icon-layer></div>
            </div>
            <div
              class="personalization-preview-modal__safe-area-warning"
              data-personalization-safe-area-warning
              hidden
            >
              <span>You can't engrave here.</span>
            </div>
          </div>
        </div>

        <div class="personalization-preview-modal__editor">
          <div class="personalization-preview-modal__fields">
            <div class="personalization-preview-modal__field">
              <p class="form__label">Choose clip style</p>
              <div class="personalization-preview-modal__field-group">
                <div class="personalization-preview-modal__field">
                  <label class="form__label" for="PersonalizationStyleFamily">Style family</label>
                  <select
                    id="PersonalizationStyleFamily"
                    class="personalization-preview-modal__input personalization-preview-modal__select"
                    data-personalization-input="styleFamily"
                  ></select>
                </div>

                <div class="personalization-preview-modal__field">
                  <label class="form__label" for="PersonalizationStyleVariant">Style option</label>
                  <select
                    id="PersonalizationStyleVariant"
                    class="personalization-preview-modal__input personalization-preview-modal__select"
                    data-personalization-input="styleVariant"
                  ></select>
                </div>
              </div>
            </div>

            <div class="personalization-preview-modal__field-group">
              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationLastName">Last name</label>
                <input
                  id="PersonalizationLastName"
                  class="personalization-preview-modal__input"
                  type="text"
                  autocomplete="off"
                  placeholder="Ex: The Johnsons"
                  data-personalization-input="lastName"
                >
              </div>

              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationDate">Date</label>
                <input
                  id="PersonalizationDate"
                  class="personalization-preview-modal__input"
                  type="text"
                  autocomplete="off"
                  placeholder="MM/DD/YYYY"
                  data-personalization-input="date"
                >
              </div>
            </div>

            <div class="personalization-preview-modal__field-group">
              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationLastNameFont">Last name font</label>
                <select
                  id="PersonalizationLastNameFont"
                  class="personalization-preview-modal__input personalization-preview-modal__select"
                  data-personalization-input="lastNameFont"
                ></select>
              </div>

              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationDateFont">Date font</label>
                <select
                  id="PersonalizationDateFont"
                  class="personalization-preview-modal__input personalization-preview-modal__select"
                  data-personalization-input="dateFont"
                ></select>
              </div>
            </div>

            <div class="personalization-preview-modal__field-group">
              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationFlowerIcon">Icon</label>
                <select
                  id="PersonalizationFlowerIcon"
                  class="personalization-preview-modal__input personalization-preview-modal__select personalization-preview-modal__icon-native-select"
                  data-personalization-input="flowerIcon"
                  data-personalization-icon-registry-url="{{ 'quickclip-icons.json' | asset_url }}"
                >
                </select>
                <div
                  class="personalization-preview-modal__icon-list"
                  data-personalization-icon-list
                  role="listbox"
                  aria-label="Available icons"
                ></div>
              </div>
            </div>
          </div>

          <p class="personalization-preview-modal__error" role="alert" hidden data-personalization-error></p>

          <div class="personalization-preview-modal__actions">
            <button type="button" class="button button--secondary" data-personalization-cancel>Cancel</button>
            <button type="button" class="button button--secondary" data-personalization-generate>
              <span class="personalization-preview-modal__button-spinner" aria-hidden="true"></span>
              <span class="personalization-preview-modal__button-label" data-personalization-generate-label>Generate</span>
            </button>
            <button type="button" class="button" data-personalization-save>Save preview</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</modal-dialog>
