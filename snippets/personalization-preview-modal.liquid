<modal-dialog id="PersonalizationPreviewModal" class="personalization-preview-modal">
  <div
    role="dialog"
    aria-modal="true"
    aria-label="Personalization preview"
    class="personalization-preview-modal__content global-settings-popup"
    tabindex="-1"
  >
    <button
      id="ModalClose-PersonalizationPreviewModal"
      type="button"
      class="personalization-preview-modal__toggle"
      aria-label="{{ 'accessibility.close' | t }}"
    >
      {% render 'icon-close' %}
    </button>

    <div class="personalization-preview-modal__body">
      <div class="personalization-preview-modal__header">
        <h2 class="h3">Customize Your Product</h2>
        <p class="personalization-preview-modal__product" data-personalization-product-name hidden></p>
      </div>

      <div class="personalization-preview-modal__workspace">
        <div class="personalization-preview-modal__preview" aria-live="polite" data-personalization-picked-panel>
          <p class="personalization-preview-modal__preview-label">Stage preview</p>
          <div
            class="personalization-preview-modal__blank-clip is-handwritten-1"
            data-personalization-clip-surface
            data-personalization-stage-image-url="{{ 'HorizontalOGQuickClipZoomed.jpg' | asset_url }}"
            data-personalization-safe-area-url="{{ 'HorizontalOGQuickClipZoomedOverLay.jpg' | asset_url }}"
          >
            <img
              class="personalization-preview-modal__style-preview-image"
              data-personalization-style-preview-image
              alt="Selected style preview"
              hidden
            >
            <div
              class="personalization-preview-modal__safe-area-boundary"
              data-personalization-safe-area-boundary
              aria-hidden="true"
            ></div>
            <div
              class="personalization-preview-modal__clip-guide-boundary"
              data-personalization-clip-guide-boundary
              aria-hidden="true"
              hidden
            ></div>
            <div
              class="personalization-preview-modal__deterministic-overlay"
              data-personalization-deterministic-overlay
              hidden
            >
              <div class="personalization-preview-modal__deterministic-textbox personalization-preview-modal__deterministic-textbox--name" data-personalization-textbox="lastName">
                <p class="personalization-preview-modal__deterministic-line personalization-preview-modal__deterministic-line--name" data-personalization-deterministic-last-name></p>
                <button
                  type="button"
                  class="personalization-preview-modal__rotate-handle"
                  data-personalization-rotate="lastName"
                  aria-label="Rotate text box 1"
                >
                  <span aria-hidden="true">&#8635;</span>
                </button>
                <button
                  type="button"
                  class="personalization-preview-modal__box-action personalization-preview-modal__box-action--delete"
                  data-personalization-remove-textbox="lastName"
                  aria-label="Clear text box 1"
                >
                  <span aria-hidden="true">&times;</span>
                </button>
                <button
                  type="button"
                  class="personalization-preview-modal__resize-handle"
                  data-personalization-resize="lastName"
                  aria-label="Resize text box 1"
                ></button>
              </div>
              <div class="personalization-preview-modal__deterministic-textbox personalization-preview-modal__deterministic-textbox--date" data-personalization-textbox="date">
                <p class="personalization-preview-modal__deterministic-line personalization-preview-modal__deterministic-line--date" data-personalization-deterministic-date></p>
                <button
                  type="button"
                  class="personalization-preview-modal__rotate-handle"
                  data-personalization-rotate="date"
                  aria-label="Rotate text box 2"
                >
                  <span aria-hidden="true">&#8635;</span>
                </button>
                <button
                  type="button"
                  class="personalization-preview-modal__box-action personalization-preview-modal__box-action--delete"
                  data-personalization-remove-textbox="date"
                  aria-label="Clear text box 2"
                >
                  <span aria-hidden="true">&times;</span>
                </button>
                <button
                  type="button"
                  class="personalization-preview-modal__resize-handle"
                  data-personalization-resize="date"
                  aria-label="Resize text box 2"
                ></button>
              </div>
              <div
                class="personalization-preview-modal__deterministic-textbox personalization-preview-modal__deterministic-textbox--third"
                data-personalization-textbox="thirdText"
                hidden
              >
                <p class="personalization-preview-modal__deterministic-line personalization-preview-modal__deterministic-line--third" data-personalization-deterministic-third-text></p>
                <button
                  type="button"
                  class="personalization-preview-modal__rotate-handle"
                  data-personalization-rotate="thirdText"
                  aria-label="Rotate text box 3"
                >
                  <span aria-hidden="true">&#8635;</span>
                </button>
                <button
                  type="button"
                  class="personalization-preview-modal__box-action personalization-preview-modal__box-action--delete"
                  data-personalization-remove-textbox="thirdText"
                  aria-label="Remove text box 3"
                >
                  <span aria-hidden="true">&times;</span>
                </button>
                <button
                  type="button"
                  class="personalization-preview-modal__resize-handle"
                  data-personalization-resize="thirdText"
                  aria-label="Resize text box 3"
                ></button>
              </div>
              <div class="personalization-preview-modal__icon-layer" data-personalization-icon-layer></div>
            </div>
            <div
              class="personalization-preview-modal__safe-area-warning"
              data-personalization-safe-area-warning
              hidden
            ></div>
          </div>
        </div>

        <div class="personalization-preview-modal__editor">
          <div class="personalization-preview-modal__fields">
            <div class="personalization-preview-modal__field" hidden style="display: none;" aria-hidden="true">
              <label class="form__label" for="PersonalizationStyle">Choose clip style</label>
              <select
                id="PersonalizationStyle"
                class="personalization-preview-modal__input personalization-preview-modal__select"
                data-personalization-input="style"
              ></select>
            </div>

            <div class="personalization-preview-modal__field-group">
              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationLastName">Text box 1</label>
                <input
                  id="PersonalizationLastName"
                  class="personalization-preview-modal__input"
                  type="text"
                  autocomplete="off"
                  placeholder="Ex: The Johnsons"
                  data-personalization-input="lastName"
                >
              </div>

              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationDate">Text box 2</label>
                <input
                  id="PersonalizationDate"
                  class="personalization-preview-modal__input"
                  type="text"
                  autocomplete="off"
                  placeholder="Ex: 03/09/2026"
                  data-personalization-input="date"
                >
              </div>
            </div>

            <div class="personalization-preview-modal__field-group">
              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationLastNameFont">Text box 1 font</label>
                <select
                  id="PersonalizationLastNameFont"
                  class="personalization-preview-modal__input personalization-preview-modal__select"
                  data-personalization-input="lastNameFont"
                ></select>
              </div>

              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationDateFont">Text box 2 font</label>
                <select
                  id="PersonalizationDateFont"
                  class="personalization-preview-modal__input personalization-preview-modal__select"
                  data-personalization-input="dateFont"
                ></select>
              </div>
            </div>

            <div class="personalization-preview-modal__field personalization-preview-modal__third-text-add" data-personalization-third-text-add-wrapper>
              <button
                type="button"
                class="button button--secondary personalization-preview-modal__third-text-add-button"
                data-personalization-add-third-text
              >
                Add text box 3
              </button>
            </div>

            <div
              class="personalization-preview-modal__field-group personalization-preview-modal__field-group--third-text"
              data-personalization-third-text-fields
              hidden
            >
              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationThirdText">Text box 3</label>
                <input
                  id="PersonalizationThirdText"
                  class="personalization-preview-modal__input"
                  type="text"
                  autocomplete="off"
                  placeholder="Add a third line"
                  data-personalization-input="thirdText"
                >
              </div>

              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationThirdTextFont">Text box 3 font</label>
                <select
                  id="PersonalizationThirdTextFont"
                  class="personalization-preview-modal__input personalization-preview-modal__select"
                  data-personalization-input="thirdTextFont"
                ></select>
              </div>
            </div>

            <div class="personalization-preview-modal__field-group">
              <div class="personalization-preview-modal__field">
                <label class="form__label" for="PersonalizationFlowerIcon">Icon (optional)</label>
                <select
                  id="PersonalizationFlowerIcon"
                  class="personalization-preview-modal__input personalization-preview-modal__select personalization-preview-modal__icon-native-select"
                  data-personalization-input="flowerIcon"
                  data-personalization-icon-registry-url="{{ 'quickclip-icons.json' | asset_url }}"
                >
                </select>
                <div
                  class="personalization-preview-modal__icon-list"
                  data-personalization-icon-list
                  role="listbox"
                  aria-label="Available icons"
                ></div>
              </div>
            </div>

            <div class="personalization-preview-modal__field">
              <label class="form__label" for="PersonalizationUploadedArtwork">Photo or logo (optional)</label>
              <input
                id="PersonalizationUploadedArtwork"
                class="personalization-preview-modal__input personalization-preview-modal__file-input"
                type="file"
                accept="image/png,image/jpeg,image/webp,image/svg+xml"
                data-personalization-input="uploadedArtwork"
              >
              <p class="personalization-preview-modal__field-note">
                Upload a PNG, JPG, WebP, or SVG and we&apos;ll preview it in the engraved brown finish.
              </p>
              <div
                class="personalization-preview-modal__upload-meta"
                data-personalization-upload-meta
                hidden
              >
                <span class="personalization-preview-modal__upload-name" data-personalization-upload-name></span>
                <button
                  type="button"
                  class="button button--secondary personalization-preview-modal__upload-clear"
                  data-personalization-upload-clear
                >
                  Remove upload
                </button>
              </div>
            </div>
          </div>

          <p class="personalization-preview-modal__error" role="alert" hidden data-personalization-error></p>

          <div class="personalization-preview-modal__actions">
            <button type="button" class="button button--secondary" data-personalization-cancel>Cancel</button>
            <button type="button" class="button button--secondary" data-personalization-generate>
              <span class="personalization-preview-modal__button-spinner" aria-hidden="true"></span>
              <span class="personalization-preview-modal__button-label" data-personalization-generate-label>Generate</span>
            </button>
            <button type="button" class="button" data-personalization-save>Save preview</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</modal-dialog>
